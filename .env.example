# Copy to .env and replace every placeholder before starting Docker Compose.
POSTGRES_DB=pri
POSTGRES_USER=pri
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
API_PORT=5000
JWT_KEY=replace-with-a-random-secret-at-least-32-characters-long
SEED_ADMIN_EMAIL=admin@pri.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_DISPLAY_NAME=Admin
