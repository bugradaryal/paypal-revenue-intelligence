# Single source of truth for the backend API address.
# Copy to .env and adjust. Never hard-code API URLs anywhere else.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# "mock": everything is sample data, no login.
# "real": login is real (JWT); operations the contract lists as Ready call the backend,
#         all others stay on the mock adapter (and the "Mock data" badge stays visible).
VITE_DATA_SOURCE=mock
