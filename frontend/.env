# Single source of truth for the backend API address.
# Copy to .env and adjust. Never hard-code API URLs anywhere else.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# "mock": sample data is used and login is disabled.
# "real": login and implemented revenue, AI cost, and settings operations use the backend;
#         AI Workspace chat stays on mock until its streaming API is available.
VITE_DATA_SOURCE=mock
